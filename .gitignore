# ajan yapılandırması (.claude/) tutar. Kod repoları (oksis-api, oksis-ui)
# kardeş klasörlerde, kendi git geçmişleriyle yaşar.
# =============================================================================

# --- IDE / OS ---
.vs/
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- Claude yerel ayarları ---
.claude/settings.local.json

# --- Superpowers yerel çalışma artıkları ---
.superpowers/

# --- Obsidian (tek vault: docs/) ---
# Panel/sekme durumu makineye özeldir; graph, eklenti ve görünüm ayarları
# paylaşılır. Vault kökü docs/'tur — depo kökünde açılan vault ayarı izlenmez.
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json
/.obsidian/
